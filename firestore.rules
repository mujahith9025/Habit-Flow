rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth Check Helper: Ensures the user can only access their own private data
    function isAuthenticated(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 1. User Profile Document
    match /users/{userId} {
      allow read, write: if isAuthenticated(userId);
      
      // 2. Habits Collection (Allow authenticated owners full sync access)
      match /habits/{habitId} {
        allow read, write: if isAuthenticated(userId);
        
        // 3. Habit Entries Subcollection (Completions, Notes, Reflections)
        match /entries/{dateKey} {
          allow read, write: if isAuthenticated(userId);
        }
      }

      // 4. Financial / Expense Entries Collection
      match /expense_entries/{dateKey} {
        allow read, write: if isAuthenticated(userId);
      }

      // 5. Expense Settings Configuration
      match /expense_settings/{settingId} {
        allow read, write: if isAuthenticated(userId);
      }

      // Catch-all for any other nested subcollections under the authenticated user (e.g. backup, logs)
      match /{subcollection=**} {
        allow read, write: if isAuthenticated(userId);
      }
    }
    
    // Explicitly deny access to any other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
