rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Strict User Isolation: Authenticated users can ONLY read and write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // All user subcollections (habits, entries, expense_entries, expense_settings, etc.)
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Explicitly deny access to any other collections or documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
